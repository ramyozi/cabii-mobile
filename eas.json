{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "yarn": "1.22.22",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "ENV": "development"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "developmentClient": false,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
